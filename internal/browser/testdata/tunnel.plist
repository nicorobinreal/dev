<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.browser.shop.tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/ssh</string>
		<string>-N</string>
		<string>-R</string>
		<string>9301:127.0.0.1:9301</string>
		<string>-o</string>
		<string>ServerAliveInterval=15</string>
		<string>-o</string>
		<string>ServerAliveCountMax=2</string>
		<string>-o</string>
		<string>ExitOnForwardFailure=yes</string>
		<string>-o</string>
		<string>BatchMode=yes</string>
		<string>-F</string>
		<string>/Users/alice/.ssh/config</string>
		<string>lima-shop</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DEV_NO_UPDATE</key>
		<string>1</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/alice/.local/state/dev/logs/browser-shop-tunnel.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alice/.local/state/dev/logs/browser-shop-tunnel.log</string>
</dict>
</plist>
